# PostgreSQL connection (required)
DATABASE_URL=postgres://cms:your_password@localhost:5432/college_cms

# Server
PORT=4000
NODE_ENV=production

# Admin access tokens (required for /api/admin routes).
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace_with_long_random_value
EDITOR_TOKEN=replace_with_long_random_value

# Optional: number of trusted proxies in front of Express (e.g. nginx).
# Set to "true" (1) or an integer hop count when behind a reverse proxy so
# rate limiting sees the real client IP from X-Forwarded-For.
# TRUST_PROXY=1

# Optional: override the global API rate limit (default 300 requests / 60s).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Optional: per-scope auth rate limit for login-sensitive routes
# (default 30 requests / 60s per IP).
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# Optional: disable rate limiting entirely (local development / tests only).
# RATE_LIMIT_DISABLED=true

# Optional: SSE heartbeat interval in ms (default 25000) and max concurrent
# event-stream clients (default 100; further clients receive 503).
# SSE_HEARTBEAT_MS=25000
# SSE_MAX_CLIENTS=100

# Optional: comma-separated origins allowed by CORS
# (defaults to http://localhost:5173 in development).
# CORS_ORIGINS=https://www.example.com,https://example.com
